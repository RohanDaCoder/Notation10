{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notation10",
  "version": "0.3.0",
  "identifier": "com.rohandacoder.notation10",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notation10",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32.png", "icons/128.png", "icons/256.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    }
  }
}
